# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - BACKEND
# ==========================================

PROJECT_NAME="AI Interactive Canvas API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Bảo mật & JWT
SECRET_KEY="replace_this_with_a_super_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 1 ngày
REFRESH_TOKEN_EXPIRE_DAYS=14           # 14 ngày (phiên giáo viên)

# Cơ sở dữ liệu (Mặc định dùng SQLite cho môi trường dev, có thể đổi sang PostgreSQL)
DATABASE_URL="sqlite:///./canvas_app.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/canvas_db"

# AI Services
GEMINI_API_KEY="your_gemini_api_key_here"
MATHPIX_APP_ID="your_mathpix_app_id"
MATHPIX_APP_KEY="your_mathpix_app_key"

# Lưu trữ hình ảnh & Snapshot
UPLOAD_DIR="./uploads"
SNAPSHOT_DIR="./uploads/snapshots"

# CORS Origins (Các domain được phép truy cập API)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
