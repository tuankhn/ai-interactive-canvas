APP_NAME="AI Interactive Canvas API"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000

# PostgreSQL 16+
DATABASE_URL="postgresql+psycopg2://aicanvas:aicanvas_secret@localhost:5432/ai_interactive_canvas"

# Redis 7+
REDIS_URL="redis://localhost:6379/0"

# MinIO Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="board-snapshots"
MINIO_SECURE=false

# AI Keys (Gemini 2.5 Flash & Mathpix)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
MATHPIX_APP_ID=""
MATHPIX_APP_KEY=""
