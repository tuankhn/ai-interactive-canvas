APP_NAME="AI Interactive Canvas API"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
SEED_DEMO_ON_STARTUP=true

# PostgreSQL 16+
DATABASE_URL="postgresql+psycopg2://aicanvas:aicanvas_secret@localhost:5432/ai_interactive_canvas"

# Redis 7+
REDIS_URL="redis://localhost:6379/0"

# MinIO Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="board-snapshots"
MINIO_SECURE=false

# Tài khoản Admin Demo mặc định & Hạn ngạch AI / MinIO
ADMIN_EMAIL="admin@aicanvas.edu.vn"
ADMIN_PASSWORD="Admin@2026"
DEMO_DEFAULT_PASSWORD="Demo@2026"
GEMINI_MONTHLY_QUOTA=10000
MATHPIX_MONTHLY_QUOTA=5000
MINIO_STORAGE_QUOTA_MB=5120

# AI Keys (Gemini & Mathpix — hỗ trợ 1 hoặc nhiều key cách nhau dấu phẩy chống quá tải 429)
GEMINI_API_KEY=""
GEMINI_API_KEYS=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-flash-latest"
MATHPIX_APP_ID=""
MATHPIX_APP_KEY=""
